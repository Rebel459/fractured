{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}-fabric",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": [
    "${mod_author}"
  ],
  "contact": {
    "sources": "https://github.com/Rebel459/fractured"
  },
  "license": "${license}",
  "icon": "assets/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "net.rebel459.fractured.FracturedFabric"
    ],
    "client": [
      "net.rebel459.fractured.FracturedFabricClient"
    ],
    "modmenu": [
      "net.rebel459.fractured.config.FracturedModMenuIntegration"
    ]
  },
  "mixins": [
    "fractured.mixins.json",
    "fractured-fabric.mixins.json"
  ],
  "accessWidener": "fractured.classtweaker",
  "depends": {
    "fabricloader": ">=0.18",
    "fabric-api": "*",
    "minecraft": "${fabric_minecraft_version}",
    "java": ">=25",
    "unified": "*",
    "cloth-config": "*"
  }
}